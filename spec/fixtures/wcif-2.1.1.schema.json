                  "type": "object",
                  "properties": {
                    "participationSource": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": { "type": { "const": "registrations" } }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": { "const": "round" },
                            "roundId": { "type": "string" },
                            "resultCondition": {
                              "oneOf": [
                                { "type": "null" },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "const": "resultAchieved" },
                                    "scope": {
                                      "type": "string",
                                      "enum": ["single", "average"]
                                    },
                                    "value": { "type": ["integer", "null"] }
                                  }
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "const": "ranking" },
                                    "scope": {
                                      "type": "string",
                                      "enum": ["single", "average"]
                                    },
                                    "value": { "type": "integer" }
                                  }
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "const": "percent" },
                                    "scope": {
                                      "type": "string",
                                      "enum": ["single", "average"]
                                    },
                                    "value": { "type": "integer" }
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": { "const": "linkedRounds" },
                            "roundIds": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "resultCondition": {
                              "oneOf": [
                                { "type": "null" },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "const": "resultAchieved" },
                                    "scope": {
                                      "type": "string",
                                      "enum": ["single", "average"]
                                    },
                                    "value": { "type": ["integer", "null"] }
                                  }
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "const": "ranking" },
                                    "scope": {
                                      "type": "string",
                                      "enum": ["single", "average"]
                                    },
                                    "value": { "type": "integer" }
