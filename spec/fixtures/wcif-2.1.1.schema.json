          "registrantId": { "type": ["integer", "null"] },
          "name": { "type": "string" },
          "wcaUserId": { "type": "integer" },
          "wcaId": { "type": ["string", "null"] },
          "countryIso2": { "type": "string" },
          "gender": { "type": "string", "enum": ["m", "f", "o"] },
          "birthdate": { "type": "string" },
          "email": { "type": "string" },
          "avatar": {
            "type": ["object", "null"],
            "properties": {
              "url": { "type": "string" },
              "thumbUrl": { "type": "string" }
            }
          },
          "roles": { "type": "array", "items": { "type": "string" } },
          "registration": {
            "type": ["object", "null"],
            "properties": {
              "wcaRegistrationId": { "type": "integer" },
              "eventIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "333",
                    "222",
                    "444",
                    "555",
                    "666",
                    "777",
                    "333bf",
                    "333fm",
                    "333oh",
                    "clock",
