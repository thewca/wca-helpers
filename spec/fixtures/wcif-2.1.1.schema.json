    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "rounds": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "format": {
                  "type": "string",
                  "enum": ["1", "2", "3", "5", "a", "h", "m"]
