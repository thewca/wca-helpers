                "worldRanking": { "type": "integer" },
                "continentalRanking": { "type": "integer" },
                "nationalRanking": { "type": "integer" },
                "type": { "type": "string", "enum": ["single", "average"] }
              }
            }
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": ["object"],
              "properties": {
                "id": { "type": "string" },
                "specUrl": { "type": "string" },
